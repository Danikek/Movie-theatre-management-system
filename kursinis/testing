import unittest

from movie_theatre import (
    validate_non_empty,
    validate_positive_int,
    validate_date,
    Movie,
    Show,
    Seat,
    ShowSeats,
    Customer,
    RegularTicket,
    VIPTicket,
    Booking,
    TicketFactory,
)


class TestMovieTheatreSystem(unittest.TestCase):
    def test_validate_non_empty_valid(self):
        self.assertEqual(validate_non_empty("Avatar", "Title"), "Avatar")

    def test_validate_non_empty_invalid(self):
        with self.assertRaises(ValueError):
            validate_non_empty("   ", "Title")

    def test_validate_positive_int_valid(self):
        self.assertEqual(validate_positive_int("120", "Duration"), 120)

    def test_validate_date_valid(self):
        self.assertEqual(
            validate_date("2026-04-13", "Show Date"),
            "2026-04-13"
        )

    def test_movie_creation(self):
        movie = Movie("M1", "Inception", "Sci-Fi", 148, "PG-13", "2026-04-13")
        self.assertEqual(movie.title, "Inception")
        self.assertEqual(movie.genre, "Sci-Fi")

    def test_show_creation(self):
        movie = Movie("M1", "Inception", "Sci-Fi", 148, "PG-13", "2026-04-13")
        show = Show("S1", movie, 1, "2026-04-13", "18:00", 12.5)
        self.assertEqual(show.show_id, "S1")
        self.assertEqual(show.get_showtime(), "2026-04-13 18:00")

    def test_seat_booking(self):
        seat = Seat("S1")
        self.assertTrue(seat.book_seat())
        self.assertTrue(seat.is_booked())

    def test_show_seats_book_seat(self):
        show_seats = ShowSeats("SHOW1", 5)
        result = show_seats.book_seat("S2")
        self.assertEqual(result, "Seat booked successfully.")

    def test_regular_and_vip_ticket_prices(self):
        regular_ticket = RegularTicket("S1", 10)
        vip_ticket = VIPTicket("S2", 10)
        self.assertEqual(regular_ticket.calculate_total(), 10)
        self.assertEqual(vip_ticket.calculate_total(), 15)

    def test_booking_creation(self):
        movie = Movie("M1", "Inception", "Sci-Fi", 148, "PG-13", "2026-04-13")
        show = Show("S1", movie, 1, "2026-04-13", "18:00", 12.5)
        customer = Customer("C1", "John")
        ticket = RegularTicket("S1", 12.5)
        booking = Booking("B1", customer, show, ticket)

        self.assertEqual(booking.booking_id, "B1")
        self.assertEqual(booking.customer.name, "John")
        self.assertEqual(booking.ticket.seat_number, "S1")

    def test_factory_creates_regular_ticket(self):
        ticket = TicketFactory.create_ticket("1", "S1", 10)
        self.assertIsInstance(ticket, RegularTicket)

    def test_factory_creates_vip_ticket(self):
        ticket = TicketFactory.create_ticket("2", "S2", 10)
        self.assertIsInstance(ticket, VIPTicket)

    def test_factory_returns_none_for_invalid_choice(self):
        ticket = TicketFactory.create_ticket("3", "S3", 10)
        self.assertIsNone(ticket)

    def test_factory_creates_ticket_by_name(self):
        ticket = TicketFactory.create_ticket_by_name(
            "VIP Ticket",
            "S1",
            10
        )
        self.assertIsInstance(ticket, VIPTicket)


if __name__ == "__main__":
    unittest.main()